# stellar-reconcile API configuration. Copy to .env for local development.
# Placeholder values only — never commit real credentials.

NODE_ENV=development
HOST=0.0.0.0
PORT=4020
LOG_LEVEL=info

# PostgreSQL. Leave unset to use in-memory storage (development/tests only).
DATABASE_URL=postgres://reconcile:reconcile@localhost:5432/reconcile

# testnet | mainnet | custom. Horizon is used for account payment history.
STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Exception severity thresholds (absolute amount in asset units)
SEVERITY_MEDIUM=100
SEVERITY_HIGH=1000
SEVERITY_CRITICAL=10000

CORS_ORIGINS=*
